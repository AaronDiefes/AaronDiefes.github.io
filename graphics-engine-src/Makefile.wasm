# WebAssembly build configuration for 2D Graphics Engine
# Requires Emscripten SDK: source ~/emsdk/emsdk_env.sh

# Compiler
# em++, not emcc: newer Emscripten (6.x) no longer infers C++ from the source
# extensions here, and emcc links without the C++ runtime, so every `operator new`
# in my_canvas.cpp comes out as an undefined symbol at wasm-ld time.
EMCC = em++

# Compiler flags
CXXFLAGS = -std=c++17 -O3 -DNDEBUG -Wno-narrowing
CXXFLAGS += -I./include

# Emscripten-specific flags
EMFLAGS = --bind
EMFLAGS += -s WASM=1
EMFLAGS += -s ALLOW_MEMORY_GROWTH=1
EMFLAGS += -s MODULARIZE=1
EMFLAGS += -s EXPORT_NAME="GraphicsEngine"
EMFLAGS += -s EXPORTED_FUNCTIONS='["_malloc","_free"]' -s EXPORTED_RUNTIME_METHODS='["cwrap","ccall","HEAPU8","HEAPU32","FS"]'
EMFLAGS += -s NO_EXIT_RUNTIME=1
EMFLAGS += -s ASSERTIONS=0
EMFLAGS += -s ENVIRONMENT=web
EMFLAGS += -s FORCE_FILESYSTEM=1
EMFLAGS += -s MALLOC=emmalloc

# Source files (now includes file I/O for image loading)
CORE_SRC = my_canvas.cpp \
           my_final.cpp \
           matrix_transform.cpp \
           src/GBitmap.cpp \
           src/GBitmap_lode.cpp \
           src/lodepng.cpp \
           src/GPath.cpp \
           src/GTime.cpp \
           wasm_bindings.cpp

# Output files
OUTPUT = graphics_engine

all: $(OUTPUT).js

$(OUTPUT).js: $(CORE_SRC)
	$(EMCC) $(CXXFLAGS) $(EMFLAGS) $(CORE_SRC) -o $(OUTPUT).js

clean:
	rm -f $(OUTPUT).js $(OUTPUT).wasm $(OUTPUT).wasm.map

.PHONY: all clean
